# Shopify (headless). Copy to .env.local and fill in. All server-only unless prefixed NEXT_PUBLIC_.
SHOPIFY_STORE_DOMAIN=makzos-dev.myshopify.com
SHOPIFY_API_VERSION=2026-10

# Headless channel → your storefront → Storefront API
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# Headless channel → your storefront → Customer Account API (confidential client)
SHOPIFY_CUSTOMER_CLIENT_ID=
SHOPIFY_CUSTOMER_CLIENT_SECRET=

# Dev Dashboard app "makzos-backend" (client credentials; read_orders) — guest order tracking
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

# Settings → Notifications → Webhooks → "Your webhooks will be signed with …"
SHOPIFY_WEBHOOK_SECRET=

# 32+ random bytes: openssl rand -base64 32
SESSION_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
